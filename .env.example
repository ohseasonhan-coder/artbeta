# 서버 전용 비밀키입니다. NEXT_PUBLIC_ 접두사를 붙이지 마세요.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# 빈 사진 영역용 이미지 생성 모델입니다. 지원되지 않으면 Vercel에서 사용 가능한 이미지 모델로 변경하세요.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Gemini 키가 없거나 실패할 때 사용할 선택적 OpenAI 대체 경로입니다.
OPENAI_API_KEY=
# 최고 품질 기본값. 비용·속도 우선이면 gpt-5.6-terra로 바꿀 수 있습니다.
OPENAI_MODEL=gpt-5.6-sol

# 웹 이미지 검색(필요한 검색원만 설정해도 됩니다)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
YOUTUBE_API_KEY=
